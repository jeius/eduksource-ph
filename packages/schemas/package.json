{
  "name": "@eduksource/schemas",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lesson-plan": {
      "types": "./dist/lesson-plan.d.ts",
      "default": "./dist/lesson-plan.js"
    },
    "./lesson-plan.js": {
      "types": "./dist/lesson-plan.d.ts",
      "default": "./dist/lesson-plan.js"
    },
    "./slide-deck": {
      "types": "./dist/slide-deck.d.ts",
      "default": "./dist/slide-deck.js"
    },
    "./slide-deck.js": {
      "types": "./dist/slide-deck.d.ts",
      "default": "./dist/slide-deck.js"
    },
    "./system-fields": {
      "types": "./dist/system-fields.d.ts",
      "default": "./dist/system-fields.js"
    },
    "./system-fields.js": {
      "types": "./dist/system-fields.d.ts",
      "default": "./dist/system-fields.js"
    },
    "./studio-constants": {
      "types": "./dist/studio-constants.d.ts",
      "default": "./dist/studio-constants.js"
    },
    "./studio-constants.js": {
      "types": "./dist/studio-constants.d.ts",
      "default": "./dist/studio-constants.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc --project tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format",
    "fix": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@eduksource/config": "workspace:*",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
