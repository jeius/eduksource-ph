{
  "name": "@eduksource/config",
  "private": true,
  "author": "Julius Pahama <https://www.linkedin.com/in/julius-pahama>",
  "license": "MIT",
  "type": "module",
  "description": "",
  "keywords": [],
  "exports": {
    "./biome/*": "./src/biome/*.json",
    "./ts/*": "./src/typescript/*.json",
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "default": "./dist/vitest/index.js"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "test": "vitest run",
    "merge-blob-reports": "node dist/scripts/merge-blob-reports.js",
    "report": "vitest --merge-reports coverage/merged-blob --passWithNoTests --coverage --coverage.provider=istanbul --coverage.reporter=html --coverage.reporter=text --coverage.reportsDirectory=coverage/report",
    "view-report": "open coverage/report/index.html",
    "lint": "pnpx @biomejs/biome lint",
    "check-types": "tsc --noEmit"
  }
}
