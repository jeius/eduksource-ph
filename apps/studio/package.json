{
  "name": "@eduksource/studio",
  "version": "0.0.0",
  "private": true,
  "author": "Julius Pahama <https://www.linkedin.com/in/julius-pahama>",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "check-types": "tsc --noEmit",
    "lint": "pnpx @biomejs/biome lint",
    "format": "pnpx @biomejs/biome format",
    "fix": "pnpx @biomejs/biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@eduksource/logger": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "@loglayer/hono": "^2.4.0",
    "@napi-rs/canvas": "^1.0.5",
    "hono": "^4.13.1",
    "http-status": "^2.1.0",
    "openai": "^7.4.0",
    "pdfjs-dist": "^6.2.108",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@eduksource/config": "workspace:*",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
